#!/bin/bash
# Configured by CMake
# Runs a patched CLI of vlfeat to compare to popsift-demo on .pgm/.ppm files
# found under PopSift_TESTFILE_PATH
set -u

VLFEAT_SIFT="@PopSift_VLFEAT_SIFT_BIN@"
POPSIFT_DEMO="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/popsift-demo"
COMPARE_BIN="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/popsift-compareSiftFiles"
CONVERT="@CONVERT@"
TESTFILE_PATH="@PopSift_TESTFILE_PATH@"
MAX_AVG_DIST="@PopSift_VLFEAT_MAX_AVG_DESC_DIST@"
WORKDIR="@CMAKE_CURRENT_BINARY_DIR@/run"

if [ ! -x "$VLFEAT_SIFT" ]; then
    echo "VLFeat 'sift' binary not found at: $VLFEAT_SIFT"
    echo "(expected the 'vlfeat_build' CTest fixture to have built it - was it skipped?)"
    exit 1
fi

mkdir -p "$WORKDIR"

# Sorted and newline-delimited list of image files stored in variable IMAGES
mapfile -t IMAGES < <(find "$TESTFILE_PATH" \( -iname '*.pgm' -o -iname '*.ppm' \) | sort)

if [ ${#IMAGES[@]} -eq 0 ]; then
    echo "No .pgm/.ppm test images found under $TESTFILE_PATH"
    exit 1
fi

echo "Found ${#IMAGES[@]} test image(s) under $TESTFILE_PATH"

overall_status=0
index=0

# Loop through image list. Use quotes to ensure that whitespace in filenames is OK.
for SRC_IMAGE in "${IMAGES[@]}"; do
    index=$((index + 1))
    echo ""
    echo "==================== [$index/${#IMAGES[@]}] $SRC_IMAGE ===================="

    IMAGE_NAME="$(basename "$SRC_IMAGE")"
    IMAGE_DIR="$WORKDIR/$(printf '%04d' "$index")-${IMAGE_NAME%.*}"
    mkdir -p "$IMAGE_DIR"

    (
        set -e
        cd "$IMAGE_DIR"

        case "$SRC_IMAGE" in
            *.[pP][gG][mM])
                IMAGE="$SRC_IMAGE"
                ;;
            *.[pP][pP][mM])
                if [ -z "$CONVERT" ] || [[ "$CONVERT" == *-NOTFOUND ]]; then
                    echo "Skipping: this is a .ppm and ImageMagick's 'convert' was not found."
                    exit 1
                fi
                IMAGE="$IMAGE_DIR/testimage.pgm"
                "$CONVERT" "$SRC_IMAGE" "$IMAGE"
                ;;
            *)
                echo "Skipping: unrecognized extension for $SRC_IMAGE"
                exit 1
                ;;
        esac

        echo "-- Running VLFeat sift --"
        cp "$IMAGE" ./vlfeat-input.pgm
        "$VLFEAT_SIFT" -v vlfeat-input.pgm
        sort -n vlfeat-input.sift > vlfeat.sift

        echo "-- Running popsift-demo --"
        # Call popsift with the best known flags to emulate vlfeat CLI defaults.
        "$POPSIFT_DEMO" --pgmread-loading --vlfeat-mode --desc-mode=vlfeat \
                         --write-as-uchar --write-as-orientation --norm-multi 9 \
                         --norm-mode classic \
                         --threshold 0 -i "$IMAGE"
        sort -n output-features.txt > popsift.sift

        echo "-- Comparing --"
        "$COMPARE_BIN" --max-avg-dist "$MAX_AVG_DIST" \
                       -o comparison.txt -d descriptor-distances.txt \
                       popsift.sift vlfeat.sift
    )
    image_status=$?

    if [ $image_status -ne 0 ]; then
        echo "FAILED: $SRC_IMAGE (see $IMAGE_DIR)"
        overall_status=1
    fi
done

echo ""
echo "==================== Summary ===================="
echo "Compared ${#IMAGES[@]} image(s) under $TESTFILE_PATH"
if [ $overall_status -ne 0 ]; then
    echo "One or more images failed - see the per-image output above, or"
    echo "the individual work directories under $WORKDIR."
fi

exit $overall_status

