#!/bin/bash
# Configured by CMake - see compareVlfeat/CMakeLists.txt.
# Runs VLFeat's patched sift CLI and popsift-demo on the same image with
# matching output flags, then reports (and optionally gates on) how close
# the two feature sets are.
set -e

VLFEAT_SIFT="@PopSift_VLFEAT_SIFT_BIN@"
POPSIFT_DEMO="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/popsift-demo"
COMPARE_BIN="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/popsift-compareSiftFiles"
CONVERT="@CONVERT@"
IMAGE_BASE="@PopSift_VLFEAT_TEST_IMAGE@"
MAX_AVG_DIST="@PopSift_VLFEAT_MAX_AVG_DESC_DIST@"
WORKDIR="@CMAKE_CURRENT_BINARY_DIR@/run"

mkdir -p "$WORKDIR"
cd "$WORKDIR"

if [ ! -x "$VLFEAT_SIFT" ]; then
    echo "VLFeat 'sift' binary not found at: $VLFEAT_SIFT"
    echo "(expected the 'vlfeat_build' CTest fixture to have built it - was it skipped?)"
    exit 1
fi

if [ -f "${IMAGE_BASE}.pgm" ]; then
    IMAGE="${IMAGE_BASE}.pgm"
elif [ -f "${IMAGE_BASE}.ppm" ]; then
    if [ -z "$CONVERT" ] || [[ "$CONVERT" == *-NOTFOUND ]]; then
        echo "Only a .ppm test image is available and ImageMagick's 'convert' was not found."
        exit 1
    fi
    IMAGE="$WORKDIR/testimage.pgm"
    "$CONVERT" "${IMAGE_BASE}.ppm" "$IMAGE"
else
    echo "Test image not found: ${IMAGE_BASE}.pgm or .ppm"
    echo "See testScripts/downloadOxfordDataset.sh.in to fetch the Oxford dataset,"
    echo "or set -DPopSift_VLFEAT_TEST_IMAGE=<basename without extension> to point at your own image."
    exit 1
fi

echo "== Running VLFeat sift on $IMAGE =="
cp "$IMAGE" ./vlfeat-input.pgm
"$VLFEAT_SIFT" -v vlfeat-input.pgm
sort -n vlfeat-input.sift > vlfeat.sift

echo "== Running popsift-demo on $IMAGE =="
# Flags chosen to line up with VLFeat's output format and algorithm choices;
# see ../testScripts/README.txt for the descriptor/threshold rationale.
# Tune these here as the comparison gets refined.
"$POPSIFT_DEMO" --pgmread-loading --vlfeat-mode --desc-mode=vlfeat \
                 --write-as-uchar --write-as-orientation --norm-multi 9 \
                 --threshold 0 -i "$IMAGE"
sort -n output-features.txt > popsift.sift

echo "== Comparing =="
"$COMPARE_BIN" --max-avg-dist "$MAX_AVG_DIST" \
               -o comparison.txt -d descriptor-distances.txt \
               popsift.sift vlfeat.sift
