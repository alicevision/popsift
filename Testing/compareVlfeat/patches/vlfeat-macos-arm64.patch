+# PopSift's VLFeat comparison needs on CLI
+# include make/matlab.mak
+# include make/octave.mak
 include make/doc.mak
 include make/dist.mak
 
diff --git a/make/bin.mak b/make/bin.mak
index 4f59419..85b1fbd 100644
--- a/make/bin.mak
+++ b/make/bin.mak
@@ -34,6 +34,10 @@ endif
 ifeq ($(ARCH),maci64)
 endif
 
+# Mac OS X on Apple Silicon (ARM64)
+ifeq ($(ARCH),arm64)
+endif
+
 # Linux-32
 ifeq ($(ARCH),glnx86)
 BIN_LDFLAGS += -Wl,--rpath,\$$ORIGIN/
diff --git a/make/dll.mak b/make/dll.mak
index 7895c75..e015748 100644
--- a/make/dll.mak
+++ b/make/dll.mak
@@ -62,6 +62,15 @@ endif
 ifeq ($(ARCH),maci64)
 DLL_SUFFIX := dylib
 DLL_LDFLAGS += -m64
+DLL_DYLIB_UNDEFINED_FLAG := -undefined suppress
+DLL_DYLIB_ISYSROOT_FLAG := -isysroot $(SDKROOT)
+endif
+
+# Mac OS X on Apple Silicon (ARM64).
+ifeq ($(ARCH),arm64)
+DLL_SUFFIX := dylib
+DLL_LDFLAGS = $(STD_LDFLAGS)
+DLL_LDFLAGS += -m64
 endif
 
 # Linux-32
@@ -122,12 +135,12 @@ $(BINDIR)/objs/%.d : $(VLDIR)/vl/%.c $(dll-dir)
 $(BINDIR)/lib$(DLL_NAME).dylib : $(dll_obj)
 	$(call C,CC)						\
 	  -dynamiclib						\
-	  -undefined suppress					\
+	  $(DLL_DYLIB_UNDEFINED_FLAG)				\
 	  -flat_namespace					\
 	  -install_name @loader_path/lib$(DLL_NAME).dylib	\
 	  -compatibility_version $(VER)				\
 	  -current_version $(VER)				\
-	  -isysroot $(SDKROOT)					\
+	  $(DLL_DYLIB_ISYSROOT_FLAG)				\
 	  $(DLL_LDFLAGS)					\
 	  $(^)							\
 	  -o "$(@)"
