diff --git a/Makefile b/Makefile
index 908c578..02e81c5 100644
--- a/Makefile
+++ b/Makefile
@@ -96,10 +96,10 @@ SHELL = /bin/bash
 all:
 
 # Select which features to disable
-# DISABLE_SSE2=yes
-# DISABLE_AVX=yes
+DISABLE_SSE2=yes
+DISABLE_AVX=yes
 # DISABLE_THREADS=yes
